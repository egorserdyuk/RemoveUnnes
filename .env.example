# Copy to .env and fill in (never commit .env).
# Used by `python bot.py` and `docker compose`.

# Telegram bot token from @BotFather.
BOT_TOKEN=123456:ABC-defGhIJKlmNoPQRsTUVwxyZ

# Bot -> Postgres connection string.
# Use host `db` when running the bot in Docker, `localhost` when running locally.
POSTGRES_DSN=postgresql://remover:remover@db:5432/remover

# Postgres container settings (used by docker-compose.yml).
POSTGRES_USER=remover
POSTGRES_PASSWORD=remover
POSTGRES_DB=remover
POSTGRES_PORT=5432
