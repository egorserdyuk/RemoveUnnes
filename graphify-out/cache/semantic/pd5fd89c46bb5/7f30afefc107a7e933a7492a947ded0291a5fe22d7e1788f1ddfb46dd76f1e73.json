{"nodes": [{"id": "docs_superpowers_plans_2026_10_13_telegram_cleaner_implementation_plan", "label": "Implementation plan", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-13-telegram-cleaner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plan implements the design as a single async polling process with pure classify, asyncpg DB layer, three routers, and keyboard builders."}, {"id": "plan_architecture", "label": "Plan architecture", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-13-telegram-cleaner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Architecture uses no FSM and no webhooks, only long polling."}, {"id": "plan_global_constraints", "label": "Global implementation constraints", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-13-telegram-cleaner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Constraints include aiogram v3 patterns, required env, default-allow, non-deleted service messages, English UI, and exhaustive callback prefixes."}, {"id": "plan_texts_constants", "label": "texts constants", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-13-telegram-cleaner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "texts module provides START, GROUPS_EMPTY, GROUP_TITLE, NEED_ADMIN, NOT_OWNER, CONNECTED, and STATS_EMPTY constants."}, {"id": "plan_config_settings", "label": "config.Settings and load", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-13-telegram-cleaner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "config loads BOT_TOKEN and POSTGRES_DSN and raises RuntimeError when either is missing."}, {"id": "plan_classify_module", "label": "classify module", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-13-telegram-cleaner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "classify is pure, duck-typed against aiogram Message fields, and centralizes content-type detection."}, {"id": "plan_content_types_priority", "label": "CONTENT_TYPES priority list", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-13-telegram-cleaner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CONTENT_TYPES orders story_forward, photo, video, video_note, voice, audio, document, animation, sticker, poll, contact, location, venue, dice, game, invoice, successful_payment, checklist, then text."}, {"id": "plan_classify_function", "label": "classify(message)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-13-telegram-cleaner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "classify returns the first present field in priority order or None for service and unknown messages."}, {"id": "plan_is_command_exempt", "label": "is_command_exempt(message)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-13-telegram-cleaner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Command exemption detects text starting with / and a bot_command entity at offset zero."}, {"id": "plan_db_module", "label": "db module", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-10-13-telegram-cleaner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The DB module manages asyncpg pool, schema creation, queries, and pure moderation helpers."}, {