_delete", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.9, "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "weight": 1.0}, {"source": "spec_text_command_exemption", "target": "plan_is_command_exempt", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "weight": 1.0}, {"source": "spec_ownership_transfer_fresh_start", "target": "plan_db_register_group", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "weight": 1.0}, {"source": "spec_ownership_transfer_fresh_start", "target": "spec_groups_table", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.9, "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "weight": 1.0}, {"source": "spec_readd_same_owner_keep", "target": "plan_db_register_group", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.9, "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "weight": 1.0}, {"source": "spec_db_persistence", "target": "plan_db_init_pool", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.9, "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "weight": 1.0}, {"source": "spec_db_persistence", "target": "plan_db_init_schema", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.9, "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "weight": 1.0}, {"source": "spec_flows_group_message", "target": "plan_group_router", "relation": "conceptually_related_to", "confidence": "