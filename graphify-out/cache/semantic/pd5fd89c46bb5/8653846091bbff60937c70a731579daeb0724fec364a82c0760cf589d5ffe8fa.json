{"nodes": [{"id": "docs_superpowers_specs_2026_10_13_telegram_cleaner_design_telegram_media_remover_bot", "label": "Telegram Media Remover Bot design", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bot sits above Telegram permissions and silently deletes blocked content types regardless of whether the sender is a regular member or an admin; only whitelisted users bypass the blocks. Success is zero group noise plus private owner-only per-group counters."}, {"id": "spec_intent_above_telegram_permissions", "label": "Above Telegram permissions", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normal group restrictions cannot help because some senders are admins; restricting them would require demotion, which owners avoid, so the bot deletes above Telegram permission levels."}, {"id": "spec_goals", "label": "Design goals", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Goals include private start flow, tracked group buttons, per-group settings, silent removal, owner-only controls, native user-picker whitelisting, complete content-type coverage, no-rights DMs, and persistent storage."}, {"id": "spec_non_goals", "label": "Design non-goals", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-goals exclude warnings, mutes, bans, global lists, keyword filters, group-visible logs, multi-owner roles, and webhook deployment."}, {"id": "spec_anti_goals", "label": "Design anti-goals", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bot must not post anything into the group on deletion, leak one group's data to another or to non-owners, delete service messages or its own admin notices, or cap the whitelist."}, {"id": "spec_stack", "label": "Implementation stack constraints", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stack is Python with aiogram 3.31.0, PostgreSQL, and long polling, with group privacy OFF."}, {"id": "spec_botfather_group_privacy", "label": "Group privacy requirement", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BotFather Group Privacy must be OFF or the group handler never sees normal messages."}, {"id": "spec_admin_delete_rights", "label": "Delete rights requirement", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bot needs group admin rights with can_delete_messages; otherwise it skips deletion and DMs the owner."}, {"id": "spec_content_type_coverage", "label": "Content-type coverage", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All real Telegram message content types are individually blockable, based on aiogram Message media fields."}, {"id": "spec_blocked_content_types", "label": "Blocked content types list", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coverage includes text, photo, video, video_note, voice, audio, document, animation, sticker, poll, contact, location, venue, dice, game, invoice, successful_payment, story_forward, and checklist."}, {"id": "spec_service_messages_exempt", "label": "Service messages never deleted", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Service messages such as new_chat_members, left_chat_member, pinned_message, chat_shared, and users_shared are never deleted and classify returns None."}, {"id": "spec_owner_only_control", "label": "Owner-only control and stats", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the user who started and added the bot for a group can change its settings or view its stats."}, {"id": "spec_silent_removal_no_group_noise", "label": "Silent removal", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deletions produce no group-visible message, notice, warning, or log; owner sees stats privately on demand."}, {"id": "spec_private_stats_counters", "label": "Per-group removal counters", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counters are maintained per content type per group and displayed only to the owner as removed messages."}, {"id": "spec_per_group_isolation", "label": "Per-group isolation", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blocked types, whitelist, and counters are isolated per group and default allow everything."}, {"id": "spec_unlimited_whitelist", "label": "Unlimited per-group whitelist", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The whitelist has no cap; native request_users picks up to ten users at a time and can be repeated."}, {"id": "spec_no_rights_dm_throttle", "label": "No-rights DM throttle", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When deletion fails due to insufficient rights, the owner is DM'd at most once per group per ten-minute window."}, {"id": "spec_pending_no_dm_case", "label": "Pending greetings for undmessaged owners", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Telegram forbids DMing users who never started the bot, so a pending greetings row is stored and flushed on first /start."}, {"id": "spec_anonymous_channel_handling", "label": "Anonymous and channel-post handling", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Messages without from_user cannot match the whitelist and are judged by content type only; bot self messages are always skipped."}, {"id": "spec_text_command_exemption", "label": "Command exemption when text blocked", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When text is blocked, messages starting with / whose bot_command entity is at offset zero are exempt so other bots continue working."}, {"id": "spec_caption_does_not_make_text", "label": "Caption does not reclassify media", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "classify priority places text last, so a captioned photo or video is classified as media rather than text."}, {"id": "spec_ownership_transfer_fresh_start", "label": "Re-add by different owner transfers ownership with fresh start", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If the bot is re-added by a different user, blocked, whitelist, and stats rows are wiped, owner_id transfers, and defaults are restored."}, {"id": "spec_readd_same_owner_keep", "label": "Re-add by same owner keeps settings", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-adding the bot by the same owner preserves existing group settings, counters, and whitelist."}, {"id": "spec_db_persistence", "label": "PostgreSQL persistence", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL stores settings and counters so restart preserves configuration."}, {"id": "spec_flows_private_start", "label": "Private start and group list flow", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "/start explains group usage and shows buttons for each group owned by the user."}, {"id": "spec_flows_group_message", "label": "Group message handling flow", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Group messages are classified, checked against whitelist and blocked types, deleted and counted when blocked, with edited messages rechecked."}, {"id": "spec_flows_group_config_screen", "label": "Private group config screen", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Config screen shows blocked type toggles, whitelist management, stats, reset, and data removal actions."}, {"id": "spec_db_tables_overview", "label": "PostgreSQL schema tables", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schema includes owners, groups, blocked, whitelist, stats, and optional pending_greetings or notify_state metadata."}, {"id": "spec_owners_table", "label": "owners table", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "owners stores owner user IDs and creation timestamps."}, {"id": "spec_groups_table", "label": "groups table", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "groups stores chat IDs, owner association, title, and added timestamp."}, {"id": "spec_blocked_table", "label": "blocked table", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "blocked stores the selected blocked content types per chat; absence means allowed."}, {"id": "spec_whitelist_table", "label": "whitelist table", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "whitelist stores per-chat user IDs with optional username and display and added timestamp."}, {"id": "spec_stats_table", "label": "stats table", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "stats stores removal counts per content type per chat."}, {"id": "spec_pending_greetings_table", "label": "pending_greetings table", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pending greetings store deferred connected-group notices for owners who have not started the bot yet."}, {"id": "spec_notify_state_table", "label": "notify_state table", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "notify_state stores last notification timestamps for throttling no-rights DMs."}], "edges": [{"source": "spec_intent_above_telegram_permissions", "target": "spec_non_goals", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "weight": 1.0}, {"source": "spec_intent_above_telegram_permissions", "target": "spec_admin_delete_rights", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.9, "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "weight": 1.0}, {"source": "spec_intent_above_telegram_permissions", "target": "spec_silent_removal_no_group_noise", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.9, "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "weight": 1.0}, {"source": "spec_goals", "target": "spec_flows_private_start", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": null, "weight": 1.0}, {"source": "spec_goals", "target": "spec_flows_group_config_screen", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-10-13-telegram-cleaner-design.md", "source_location": n